                    """
                }
            }
        }
        */


         stage('Take action depending on the time difference on email server') {
            agent { label "${env.SIEBEL_EMAIL_SERVER}" }

            steps {
                script {
                    // Uncomment if you want to send an email based on the time difference
                    def cleanedRecipients = env.EMAIL_RECIPIENTS.replaceAll('\\s*,\\s*', ',')  // Removes surrounding whitespace

                    def timeDifference = env.DIFF_IN_HOURS?.toInteger()
                    def timeDifference_minute = env.DIFF_IN_MINUTES?.toInteger()

                    if (timeDifference != null && timeDifference > Allowed_Hours.toInteger()) {
                        // echo "No email arrived in ${timeDifference} hours in Siebel"
                        emailext(
                            subject: "No email in ${timeDifference} hours - restarting Siebel email server",
                            body: "Email has not arrived in ${timeDifference} hours in Siebel",
                            from: 'kaustav.ganguli@treas.nj.gov',
                            to: cleanedRecipients
                        )

                        // write script to restart siebel email server
                        sh '''sudo su - sadmin -c "stop_server all;rm -rf /siebqa1/SIEBEL/siebsrvr/sys/osdf.SBA_UPROD.EMAIL;/siebqa1/SIEBEL/applicationcontainer_internal/bin/shutdown.sh;ps -eaf | grep shm | grep -v grep | awk '{print $2}'| xargs kill -9;ps -eaf | grep svc | grep -v grep | awk '{print $2}'| xargs kill -9;sleep 60;/siebqa1/SIEBEL/applicationcontainer_internal/bin/startup.sh;sleep 20;start_server all"'''

                    } else {
                        // echo "email arrived in ${timeDifference} hours"
                        echo "email arrived in ${timeDifference_minute} minutes"
                    }
                }
            }
        }

    }
}