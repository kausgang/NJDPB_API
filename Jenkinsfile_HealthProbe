pipeline {
    agent { label 'built-in' } // Use 'built-in' for modern Jenkins instances

    environment {
        ENVIRONMENT = 'PRODUCTION'
        URL_TO_CHECK = "https://ty-sblprd5-ha-e.njes.state.nj.us:1443/siebel/app/pensions/enu?SWECmd=Start"
        STRING_TO_FIND = "either busy or experiencing difficulties"
        ALERT_EMAIL = "kaustav.ganguli@treas.nj.gov"
    }

    stages {
        stage('Check Status') {
            steps {
                script {
                    // Check status via shell and capture exit code
                    // grep -q returns 0 if match is found, 1 if not
                    def status = sh(
                        script: "curl -k -sL ${URL_TO_CHECK} | grep -q '${STRING_TO_FIND}'",
                        returnStatus: true
                    )

                    if (status == 0) {
                        echo "Match found: Server is busy. Sending alert..."
                        emailext(
                            to: "${ALERT_EMAIL}",
                            subject: "ALERT!! Siebel ${ENVIRONMENT} Server Busy",
                            body: "The Siebel server is currently busy or experiencing difficulties.\nURL: ${URL_TO_CHECK}\nBuild: ${env.BUILD_URL}",
                            mimeType: 'text/plain'
                        )
                    } else {
                        echo "No match found. Server status is OK."
                    }
                }
            }
        }
    }
}
