pipeline {
    agent none

    environment {
        RUN_IN_PRODUCTION = 'true'
        WAIT_TIME = 10
        DB_CREDS = credentials('siebel-db-credentials')
    }

    options {
        skipDefaultCheckout() 
    }

    stages {
        stage('Checkout Source') {
            agent { label 'master' } 
            steps {
                checkout scm 
            }
        } 

        stage('Set Environment Variables') {
            agent { label 'master' }
            steps {
                script {
                    if (env.RUN_IN_PRODUCTION == 'true') {
                        env.ENVIRONMENT      = 'Prod'
                        env.GATEWAY_URL      = 'ty-sblprd1-ha-e.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_SSO'
                        env.LABEL_OM1        = 'np2'
                        env.LABEL_OM2        = 'np3'
                        env.LABEL_OM3        = 'np4'
                        env.LABEL_APP        = 'np1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    } else {
                        env.ENVIRONMENT      = 'Old_Prod'
                        env.GATEWAY_URL      = 'ty-sebtst4-ma-s.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_enu'
                        env.LABEL_OM1        = 'p2'
                        env.LABEL_OM2        = 'p3'
                        env.LABEL_OM3        = 'p4'
                        env.LABEL_APP        = 'p1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    }
                    echo "Running in ${env.ENVIRONMENT} environment"
                }
            }
        }

        // Parent stage to hold the sequence
        stage('Siebel Startup Sequence') {
            stages {


                stage('Start Gateway') {
                    // Use force local evaluation for labels set in previous stages
                    agent { label "${env.LABEL_APP}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c ". /siebqa1/SIEBEL/gtwysrvr/siebenv.sh; start_ns"
                            sleep 120
                        '''
                    }
                }

                stage('Parallel Start Servers') {
                    parallel {
                        stage('Start app') {
                            agent { label "${env.LABEL_APP}" }
                            steps {
                                sh 'sudo su - sadmin -c "start_server all"'
                            }
                        }
                        stage('Start EMAIL') {
                            agent { label "${env.LABEL_OM3}" }
                            steps {
                                sh 'sudo su - sadmin -c "start_server all"'
                            }
                        }
                        stage('Start OM1') {
                            agent { label "${env.LABEL_OM1}" }
                            steps {
                                sh 'sudo su - sadmin -c "start_server all"'
                            }
                        }
                        stage('Start OM2') {
                            agent { label "${env.LABEL_OM2}" }
                            steps {
                                sh 'sudo su - sadmin -c "start_server all"'
                            }
                        }
                    }
                }


                stage('Wait for OM to come up') {
                    agent { label 'master' }
                    steps {
                        echo "Waiting for ${WAIT_TIME} minute..."
                        sleep time: "${WAIT_TIME}", unit: 'MINUTES'
                    }
                }



                stage('Check Siebel Status') {
                    agent { label 'np1' }
                    steps {
                        script { // Added script block for proper execution
                            def srvrmgr_command = """
                                srvrmgr -g ${env.GATEWAY} -e ${env.ENTERPRISE} -u ${DB_CREDS_USR} -p ${DB_CREDS_PSW} -q -c "list servers show SBLSRVR_NAME,SV_DISP_STATE"
                            """
                            def srvrmgr_output = sh(script: "sudo su - sadmin -c '${srvrmgr_command}'", returnStdout: true).trim()
                            echo "Server Status: ${srvrmgr_output}"

                            emailext(
                                from: 'kaustav.ganguli@treas.nj.gov',
                                subject: "Siebel server status",
                                body: srvrmgr_output,
                                to: "kaustav.ganguli@treas.nj.gov"
                            )
                        }
                    }
                }

            }
        }
    }

    post {
        success {
            emailext (
                from:    'kaustav.ganguli@treas.nj.gov',
                to:      "${env.EMAIL_RECIPIENTS}",
                subject: "${env.ENVIRONMENT} enterprise started.",
                body:    "Siebel ${env.ENVIRONMENT} enterprise started."
            )
        }
    }
}
