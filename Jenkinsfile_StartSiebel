pipeline {
    agent none

    environment {
        RUN_IN_PRODUCTION = 'false'
        // This generates DB_CREDS_USR and DB_CREDS_PSW automatically
        DB_CREDS = credentials('siebel-db-credentials')
    }

    options {
        skipDefaultCheckout() 
    }

    stages {
        stage('Checkout Source') {
            agent { label 'master' } 
            steps {
                checkout scm 
            }
        } 

        stage('Set Environment Variables') {
            agent { label 'master' }
            steps {
                script {
                    if (env.RUN_IN_PRODUCTION == 'true') {
                        env.ENVIRONMENT      = 'Prod'
                        env.GATEWAY          = 'ty-sblprd1-ha-e.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_SSO'
                        env.OM1              = 'np2'
                        env.OM2              = 'np3'
                        env.OM3              = 'np4'
                        env.app              = 'np1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    } else {
                        env.ENVIRONMENT      = 'Old_Prod'
                        env.GATEWAY          = 'ty-sebtst4-ma-s.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_enu'
                        env.OM1              = 'p2'
                        env.OM2              = 'p3'
                        env.OM3              = 'p4'
                        env.app              = 'p1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    }
                    echo "Running in ${env.ENVIRONMENT} environment"
                }
            }
        }

        stage('Parallel Stop Siebel') {

            stage('Start gateway') {
                agent { label "${env.app}" }
                steps {
                    sh '''
                        sudo su - sadmin -c "
                            . /siebqa1/SIEBEL/gtwysrvr/siebenv.sh;
                            start_ns ;
                            sleep 120;
                        "
                    '''
                }
            }

            parallel {


                stage('Start app') {
                    agent { label "${env.app}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                start_server all;
                            "
                        '''
                    }
                }

                stage('Start EMAIL') {
                    agent { label "${env.OM3}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                start_server all;
                            "
                        '''
                    }
                }

                stage('Start OM1') {
                    agent { label "${env.OM1}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                start_server all;
                            "
                        '''
                    }
                }

                stage('Start OM2') {
                    agent { label "${env.OM2}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                start_server all;
                            "
                        '''
                    }
                }



            }
        }
    }

    post {
        success {
            emailext (
                from:    'kaustav.ganguli@treas.nj.gov',
                to:      "${env.EMAIL_RECIPIENTS}",
                subject: "${env.ENVIRONMENT} enterprise started.",
                body:    "Siebel ${env.ENVIRONMENT} enterprise started."
            )
        }
    }
}
