pipeline{

    agent none

    environment {

        IMAGE_NAME = 'njdpb-purchase'
        buildArgs = "-f ./NJDPB_CICD/Dockerfile_NJDPB_Proxy"

        
    }

    stages{

        stage('Checkout') {
            agent {label 'master'}
                    steps {
                        checkout scm
                    }
        }

        stage('Build Podman Image') {
            agent {label 'master'}
            steps {
                script 
                {
                    // def imageName = 'njdpb-purchase'
                    // def buildArgs = "-f ./NJDPB_CICD/Dockerfile_NJDPB_Proxy"

                    // // Define the specific path to the directory containing your Containerfile/Dockerfile
                    def buildPath = "${WORKSPACE}/NJDPB_API/"

                    sh """
                        # Ensure the script runs in the correct directory
                        cd ${env.buildPath}

                        # Run the podman build command within that directory
                        podman build ${env.buildArgs} -t ${env.IMAGE_NAME}:${BUILD_NUMBER} .

                        
                        # Optionally tag as latest
                        podman tag ${env.IMAGE_NAME}:${BUILD_NUMBER} ${env.IMAGE_NAME}:latest

                    """
                    echo "Image built: ${env.IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }




        
        stage('Stop Previous Container') {
            agent {label 'master'}
            steps {
                sh '''
                    if podman ps -a --format '{{.Names}}' | grep -q purchase_api; then
                        podman stop purchase_api
                        podman rm purchase_api
                    fi
                '''
            }
        }



        
        stage('Deploy New Container') {
            agent {label 'master'}
            steps {
                sh '''
                    podman run --detach --name purchase_api \
                      --env-file=/home/typgang/SiebelExternalApi/.env-purchase.properties \
                      -p 8090:8090 \
                      ${env.IMAGE_NAME}:latest \
                      --spring.profiles.active=purchase 
                      
                '''
            }
        }




    }
}