pipeline{

    agent none



    stages{

        stage('Checkout') {
            agent {label 'master'}
                    steps {
                        checkout scm
                    }
                }

        stage('Build'){

            agent {label 'master'}
            steps {
                echo 'Building the application...'
                sh '''
                    cd ./NJDPB_ADMIN_Server;
                    export JAVA_HOME=/home/typgang/Jenkins/jdk-21.0.2;
                    /home/typgang/MAVEN/apache-maven-3.9.11/bin/mvn clean package -DskipTests
                '''
            }
        }
        stage('Deploy'){

            agent { label 'master' }
            steps{

                echo "Kill the previous instance and Deploy the new change - DO IT MANUALLY"



                sh '''
        
                    echo "Copying new JAR from workspace...";
                    scp ${WORKSPACE}/NJDPB_API/target/NJDPB_ADMIN_Server-0.0.1-SNAPSHOT.jar /home/typgang/SiebelExternalApi/;

                    echo "Starting new instance...";
                    nohup /home/typgang/SiebelExternalApi/runAPI.sh > /home/typgang/SiebelExternalApi/api.log 2>&1 &
                '''

                // sh '/home/typgang/SiebelExternalApi/runAPI.sh'

