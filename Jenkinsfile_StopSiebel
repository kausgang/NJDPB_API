        //         script {
        //             // def srvrmgr_command = "srvrmgr -g ${env.GATEWAY} -e ${env.ENTERPRISE} -u ${DB_USERNAME} -p ${DB_PASSWORD} -q -c \"list servers show SBLSRVR_NAME,SV_DISP_STATE\""
        //             def srvrmgr_command = "srvrmgr -g ${env.GATEWAY} -e ${env.ENTERPRISE} -u $DB_CREDS_USR -p $DB_CREDS_PSW -q -c \"list servers show SBLSRVR_NAME,SV_DISP_STATE\""
        //             // def srvrmgr_output = sh(script: "sudo su - sadmin -c '${srvrmgr_command}'", returnStdout: true).trim()
        //             def srvrmgr_output = sh(script: "sudo su - sadmin -c '${srvrmgr_command}'", returnStdout: true).trim()
                    
        //             echo "Server Status: ${srvrmgr_output}"

        //             emailext(
