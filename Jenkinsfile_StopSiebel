pipeline {
    agent none

    environment {
        RUN_IN_PRODUCTION = 'true'
        // This generates DB_CREDS_USR and DB_CREDS_PSW automatically
        DB_CREDS = credentials('siebel-db-credentials')
    }

    options {
        skipDefaultCheckout() 
    }

    stages {
        stage('Checkout Source') {
            agent { label 'master' } 
            steps {
                checkout scm 
            }
        } 

        stage('Set Environment Variables') {
            agent { label 'master' }
            steps {
                script {
                    if (env.RUN_IN_PRODUCTION == 'true') {
                        env.ENVIRONMENT      = 'Prod'
                        env.GATEWAY          = 'ty-sblprd1-ha-e.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_SSO'
                        env.OM1              = 'np2'
                        env.OM2              = 'np3'
                        env.OM3              = 'np4'
                        env.app              = 'np1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    } else {
                        env.ENVIRONMENT      = 'Old_Prod'
                        env.GATEWAY          = 'ty-sebtst4-ma-s.njes.state.nj.us:9111'
                        env.ENTERPRISE       = 'SBA_UPROD'
                        env.COMPONENT        = 'PSCcObjMgr_enu'
                        env.OM1              = 'p2'
                        env.OM2              = 'p3'
                        env.OM3              = 'p4'
                        env.app              = 'p1'
                        env.EMAIL_RECIPIENTS = 'kaustav.ganguli@treas.nj.gov'
                    }
                    echo "Running in ${env.ENVIRONMENT} environment"
                }
            }
        }

        stage('Parallel Stop Siebel') {
            parallel {
                stage('Stop EMAIL') {
                    agent { label "${env.OM3}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                stop_server all;
                                rm -rf /siebqa1/SIEBEL/siebsrvr/sys/osdf.SBA_UPROD.EMAIL;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/shutdown.sh;
                                ps -eaf | grep shm | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                ps -eaf | grep svc | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                sleep 120;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/startup.sh;
                                sleep 20
                            "
                        '''
                    }
                }

                stage('Stop OM2') {
                    agent { label "${env.OM2}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                stop_server all;
                                rm -rf /siebqa1/SIEBEL/siebsrvr/sys/osdf.SBA_UPROD.OM2;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/shutdown.sh;
                                ps -eaf | grep shm | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                ps -eaf | grep svc | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                sleep 120;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/startup.sh;
                                sleep 20
                            "
                        '''
                    }
                }

                stage('Stop OM1') {
                    agent { label "${env.OM1}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                stop_server all;
                                rm -rf /siebqa1/SIEBEL/siebsrvr/sys/osdf.SBA_UPROD.OM1;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/shutdown.sh;
                                ps -eaf | grep shm | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                ps -eaf | grep svc | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                sleep 120;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/startup.sh;
                                sleep 20
                            "
                        '''
                    }
                }


                stage('Stop gateway') {
                    agent { label "${env.app}" }
                    steps {
                        sh '''
                            sudo su - sadmin -c "
                                stop_server all;
                                rm -rf /siebqa1/SIEBEL/siebsrvr/sys/osdf.SBA_UPROD.app;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/shutdown.sh;
                                ps -eaf | grep shm | grep -v grep | awk '{print \$2}' | xargs kill -9;
                                sleep 120;
                                /siebqa1/SIEBEL/applicationcontainer_internal/bin/startup.sh;
                                sleep 20
                                . /siebqa1/SIEBEL/gtwysrvr/siebenv.sh;
                                stop_ns;
                                ps -eaf | grep svc | grep -v grep | awk '{print \$2}' | xargs kill -9;
                            "
                        '''
                    }
                }

            }
        }
    }

    post {
        success {
            emailext (
                from:    'kaustav.ganguli@treas.nj.gov',
                to:      "${env.EMAIL_RECIPIENTS}",
                subject: "${env.ENVIRONMENT} enterprise stopped.",
                body:    "Siebel ${env.ENVIRONMENT} enterprise stopped."
            )
        }
    }
}
