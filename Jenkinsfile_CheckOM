// # HELP siebel_svc_process_count Number of SVC processes running
// # TYPE siebel_svc_process_count gauge
// siebel_svc_process_count{server="${env.OM2}",env="${env.ENVIRONMENT}"} ${processCount_svc_om2}
// # HELP siebel_shm_process_count Number of SHM processes running
// # TYPE siebel_shm_process_count gauge
// siebel_shm_process_count{server="${env.OM2}",env="${env.ENVIRONMENT}"} ${processCount_shm_om2}
// # HELP siebel_active_sessions Number of active sessions
// # TYPE siebel_active_sessions gauge
// siebel_active_sessions{server="${env.OM2}",env="${env.ENVIRONMENT}"} ${activeSession_om2}
// """

// // 3. Push to Pushgateway using HTTP Request Plugin
//     // Note: We append the instance name to the URL to distinguish metrics per server
//     httpRequest(
//         url: "${env.PUSHGATEWAY_URL}/instance/${env.OM2}",
//         httpMode: 'POST',
//         requestBody: payload,
//         contentType: 'TEXT_PLAIN',
//         validResponseCodes: '200:202'
//     )
    
//     echo "Metrics pushed to Pushgateway for ${serverName}"


                    def cleanedRecipients = env.EMAIL_RECIPIENTS.replaceAll('\\s*,\\s*', ',')  // Removes surrounding whitespace

                    // Process count email alert
                    if(processCount_svc_om2.toInteger() > 0 || processCount_shm_om2.toInteger() > 0) {
                        echo "Both SVC and SHM processes are running on ${env.OM2}"
                    } else {
                        // error("Either SVC or SHM process is not running on ${env.OM2}")
                        echo "Either SVC or SHM process is not running on ${env.OM2}"

                        emailext(
                            subject: "SVC or SHM process is not running on ${env.OM2}",
                            body: "Either SVC or SHM process is not running on ${env.OM2}",
                            from: 'kaustav.ganguli@treas.nj.gov',
                            to: cleanedRecipients
                        )
                    }

                    // Active sessions email alert
                    if(activeSession_om2.toInteger() > Allowed_Active_Sessions.toInteger()) {
                        echo "Active session count is high on ${env.OM2}"
                         emailext(
                            from: 'kaustav.ganguli@treas.nj.gov',
                            subject: "Active session count is high on ${env.OM2}",
                            body: "Active session count is ${activeSession_om2} on ${env.OM2}",
                            to: cleanedRecipients
                        )
                    } 
                    else {
                        echo "Active session count is ${activeSession_om2} on ${env.OM2}"
                    }


                }
            }
        }



        }
}
